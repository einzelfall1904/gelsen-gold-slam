    .vs { font-size: .75rem; color: var(--ink-2); font-weight: 500; }
    .status-wahl { display: flex; flex-wrap: wrap; gap: 4px; }
    .status-wahl button { flex: 1 1 auto; font: inherit; font-size: .8rem; font-weight: 700; padding: 8px 6px; min-height: 40px; border: 1.5px solid var(--line); background: #fff; border-radius: 8px; cursor: pointer; }
    .status-wahl button[aria-pressed='true'] { background: var(--navy); border-color: var(--navy); color: #fff; }
    .status-wahl button[data-wert='laeuft'][aria-pressed='true'] { background: var(--live); border-color: var(--live); }
    .status-wahl button[data-wert='beendet'][aria-pressed='true'] { background: var(--ok); border-color: var(--ok); }
