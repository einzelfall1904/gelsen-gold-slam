    .satzzeile input { text-align: center; font-size: 1.2rem; font-weight: 700; padding: 8px; width: 100%; }
    .sieger { border: 1px solid var(--gold); border-radius: 8px; padding: 8px 12px; margin: 0; background: var(--gold-soft); }
    .sieger legend { font-size: .8rem; font-weight: 700; padding: 0 4px; }
    .sieger label { display: flex; gap: 8px; align-items: center; padding: 4px 0; }
    .notiz { width: 100%; font-size: .9rem !important; }
    .pruef { margin: 0; font-size: .85rem; }
    .pruef.ok { color: var(--ok); }
    .pruef.warn { color: var(--live); }
    .e-save:disabled { opacity: .45; cursor: not-allowed; }
    .tab-wrap { overflow-x: auto; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); margin-bottom: 12px; }
    .plan { width: 100%; border-collapse: collapse; font-size: .92rem; }
    .plan th, .plan td { padding: 8px; text-align: left; border-bottom: 1px solid var(--line); white-space: nowrap; }
    .plan th { font-size: .75rem; text-transform: uppercase; letter-spacing: .05em; color: var(--ink-2); background: var(--bg-2); }
