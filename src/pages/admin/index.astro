    @media (max-width: 760px) {
      .plan thead { display: none; }
      .plan tr { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 10px; padding: 12px; border-bottom: 1px solid var(--line); position: relative; }
      .plan td { border: 0; padding: 0; white-space: normal; display: flex; flex-direction: column; gap: 2px; }
      .plan td[data-l]::before { content: attr(data-l); font-size: .72rem; font-weight: 700; color: var(--ink-2); text-transform: uppercase; }
      .plan td:last-child { position: absolute; top: 6px; right: 6px; }
      .plan select, .plan input { width: 100%; }
    }
    .x { background: none; border: 0; color: var(--ink-2); font-size: 1rem; width: 36px; height: 36px; border-radius: 8px; cursor: pointer; }
    .x:hover { background: #FCE8E4; color: var(--live); }
    .warnbox { background: #FFF4E5; border: 1px solid #F3C98B; color: #7A4B00; border-radius: var(--radius-sm); padding: 12px 16px; margin: 0 0 14px; }
    .warnbox ul { margin: 6px 0 0; padding-left: 18px; }
    .okbox { background: #E5F2EA; color: var(--ok); border-radius: var(--radius-sm); padding: 10px 14px; }
    .gruppe { margin-bottom: 28px; }
    .gruppe h2 { font-size: 1.25rem; }
    .card.form { display: grid; gap: 12px; grid-template-columns: 1fr; margin-bottom: 14px; position: relative; }
    @media (min-width: 720px) { .card.form { grid-template-columns: 1fr 1fr; } }
    .card.form h2 { grid-column: 1 / -1; font-size: 1.2rem; margin: 0; }
    .fld { display: flex; flex-direction: column; gap: 4px; }
    .fld.breit { grid-column: 1 / -1; }
    .fld label { font-weight: 700; font-size: .85rem; }
    .fld small { color: var(--ink-2); font-size: .78rem; }
    .zeile3 { padding-right: 48px; }
    .zeile3 > .x { position: absolute; top: 8px; right: 8px; }
    .karten { display: grid; gap: 0; }
    .logo-prev { grid-column: 1 / -1; display: flex; align-items: center; gap: 12px; }
    .logo-prev img { max-height: 56px; max-width: 160px; object-fit: contain; }
    .logo-prev span { font-size: .85rem; color: var(--ink-2); }
    .fotos { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); margin-top: 16px; }
    .foto { position: relative; display: flex; flex-direction: column; gap: 8px; }
    .foto img { aspect-ratio: 4/3; object-fit: cover; border-radius: 8px; width: 100%; }
    .foto > .x { position: absolute; top: 8px; right: 8px; background: rgba(255,255,255,.9); }
    .check { display: flex; gap: 8px; align-items: center; font-weight: 600; }
    .hinweisbox { background: var(--gold-soft); border-left: 4px solid var(--gold); padding: 10px 14px; border-radius: 8px; color: #5C4410; font-size: .92rem; max-width: 80ch; }
    .fstatus { margin: 0; font-size: .85rem; font-weight: 700; padding: 6px 10px; border-radius: 8px; }
    .fstatus.ok { background: #E5F2EA; color: var(--ok); }
    .fstatus.warn { background: #FCE8E4; color: var(--live); }
    .lbl { font-weight: 700; font-size: .85rem; }
    .chips { list-style: none; margin: 4px 0 6px; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
    .chips li { display: inline-flex; align-items: center; gap: 4px; padding: 3px 4px 3px 10px; border-radius: 999px; font-size: .82rem; font-weight: 600; }
    .chips li.ja { background: #E5F2EA; color: var(--ok); }
    .chips li.nein { background: #FCE8E4; color: var(--live); }
    .chips li.leer-chip { background: var(--bg-2); color: var(--ink-2); padding: 3px 10px; font-weight: 500; }
    .chips button { border: 0; background: none; color: inherit; cursor: pointer; width: 24px; height: 24px; border-radius: 50%; }
    select.ew-ja { border-color: var(--ok); color: var(--ok); font-weight: 700; }
    select.ew-nein { border-color: var(--live); color: var(--live); font-weight: 700; }
    select.ew-offen { border-color: #E3B341; }
    .danger { margin-top: 24px; border-color: #F0B7AC; }
    .leer { padding: 20px; background: #fff; border-radius: var(--radius); color: var(--ink-2); }
    .savebar { position: fixed; left: 0; right: 0; bottom: 0; background: var(--navy-deep); color: #fff; display: flex; justify-content: flex-end; align-items: center; gap: 10px; padding: 12px 16px; z-index: 40; box-shadow: 0 -6px 20px rgba(0,0,0,.2); }
    .savebar[hidden] { display: none; }
    .savebar span { margin-right: auto; font-weight: 600; }
    .savebar .btn--ghost { color: #fff; box-shadow: inset 0 0 0 1.5px rgba(255,255,255,.4); }
    .toast { position: fixed; left: 50%; bottom: 84px; transform: translate(-50%, 20px); background: var(--ok); color: #fff; padding: 12px 18px; border-radius: 10px; font-weight: 600; opacity: 0; pointer-events: none; transition: all .2s; z-index: 60; max-width: min(92vw, 560px); }
    .toast.zeigen { opacity: 1; transform: translate(-50%, 0); }
    .toast.fehler { background: var(--live); }
  </style>
