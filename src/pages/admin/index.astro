    .e-karte.st-laeuft { border-color: #F0B7AC; box-shadow: 0 0 0 3px #FCE8E4; }
    .e-karte.st-beendet { opacity: .9; }
    .e-karte header { display: flex; justify-content: space-between; font-size: .9rem; }
    .tag { background: var(--navy); color: var(--gold-bright); font-size: .75rem; font-weight: 800; padding: 2px 8px; border-radius: 6px; }
    .namen { display: grid; grid-template-columns: 1fr auto 1fr; gap: 6px; align-items: center; font-weight: 700; }
