---
import '../styles/global.css';
import { ladeDaten } from '../lib/store.js';

interface Props { title?: string; description?: string; aktiv?: string; }
const { title, description, aktiv } = Astro.props;
const { einstellungen: e } = await ladeDaten();
const seitenTitel = title ? `${title} – ${e.name} ${e.jahr}` : `${e.name} ${e.jahr}`;
const nav = [
  ['/', 'Start'],
  ['/live', 'Live-Stand'],
  ['/ausschreibung', 'Ausschreibung'],
  ['/ablauf', 'Ablauf'],
  ['/galerie', 'Galerie'],
  ['/sponsoren', 'Sponsoren'],
  ['/kontakt', 'Kontakt'],
];
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seitenTitel}</title>
    <meta name="description" content={description || `${e.untertitel} – ${e.turnierart}.`} />
    <meta name="theme-color" content="#13263A" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <!-- Animationen: Inhalt erst zeigen, wenn sie starten (spätestens nach 2,5 s, falls etwas nicht lädt) -->
    <script is:inline>document.documentElement.classList.add('js');setTimeout(function(){document.documentElement.classList.remove('js')},2500);</script>
    <style is:inline>.js main,.js footer{visibility:hidden}</style>
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt springen</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label={`${e.name} – Startseite`}>
          <img src="/media/logo-192.png" alt="" width="44" height="44" />
          <span><strong>{e.name}</strong><small>{e.jahr}</small></span>
        </a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="hauptnav">
          <span class="visually-hidden">Menü</span>
          <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
        <nav id="hauptnav" aria-label="Hauptmenü">
          <ul>
            {nav.map(([href, label]) => (
              <li><a href={href} aria-current={aktiv === href ? 'page' : undefined} class={href === '/live' ? 'nav-live' : undefined}>{label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
      <div class="progress" aria-hidden="true"></div>
    </header>

    <main id="inhalt"><slot /></main>

    <footer class="site-footer">
      <div class="wrap foot">
        <div>
          <strong>{e.name} {e.jahr}</strong><br />
          <span>{e.untertitel}</span><br />
          <span>{e.adresse}</span>
        </div>
        <ul>
          <li><a href="/kontakt">Kontakt &amp; Anfahrt</a></li>
          <li><a href="/impressum">Impressum</a></li>
          <li><a href="/datenschutz">Datenschutz</a></li>
          <li><a href="/admin">Turnierleitung</a></li>
        </ul>
      </div>
      <div class="wrap"><p class="wordmark" aria-hidden="true">Gold Slam</p></div>
    </footer>

    <script>
      import '../scripts/motion.js';
      const btn = document.querySelector('.menu-btn');
      const nav = document.getElementById('hauptnav');
      btn?.addEventListener('click', () => {
        const offen = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!offen));
        nav?.classList.toggle('offen', !offen);
      });
    </script>

    <style>
      .skip { position: absolute; left: -9999px; }
      .skip:focus { left: 16px; top: 8px; z-index: 100; background: #fff; padding: 8px 12px; }
      .site-header { background: var(--navy-deep); color: #fff; position: sticky; top: 0; z-index: 50; border-bottom: 2px solid var(--gold); }
      .bar { display: flex; align-items: center; justify-content: space-between; min-height: 64px; gap: 16px; }
      .brand { display: flex; align-items: center; gap: 10px; color: #fff; text-decoration: none; }
      .brand img { width: 44px; height: 44px; object-fit: contain; }
      .brand span { display: flex; flex-direction: column; line-height: 1.05; }
      .brand strong { font-stretch: 80%; font-weight: 850; font-size: 1.15rem; text-transform: uppercase; letter-spacing: .01em; }
      .brand small { color: var(--gold-bright); font-weight: 700; font-size: .8rem; letter-spacing: .1em; }
      .menu-btn { background: none; border: 0; color: #fff; width: 44px; height: 44px; display: grid; place-items: center; cursor: pointer; border-radius: 8px; }
      nav ul { list-style: none; margin: 0; padding: 0; }
      nav a { color: #E6EBF0; text-decoration: none; font-weight: 600; display: block; padding: 10px 12px; border-radius: 8px; }
      nav a:hover { color: #fff; background: rgba(255,255,255,.08); }
      nav a[aria-current='page'] { color: var(--gold-bright); }
      .nav-live::before { content: ''; display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--live); margin-right: 7px; vertical-align: 1px; }
      @media (max-width: 899px) {
        nav { display: none; position: absolute; left: 0; right: 0; top: 100%; background: var(--navy-deep); border-bottom: 2px solid var(--gold); padding: 8px 16px 16px; }
        nav.offen { display: block; }
        nav a { padding: 12px; font-size: 1.05rem; }
      }
      @media (min-width: 900px) {
        .menu-btn { display: none; }
        nav ul { display: flex; gap: 2px; }
      }
      .site-header { will-change: transform; }
      .progress { position: absolute; left: 0; right: 0; bottom: -2px; height: 2px; background: var(--gold-bright); transform: scaleX(0); transform-origin: left center; }
      .site-footer { background: var(--navy); color: #C9D3DD; padding: 32px 0 0; margin-top: 0; font-size: .92rem; overflow: hidden; }
      .wordmark { margin: 20px 0 -0.18em; font-size: clamp(3.6rem, 15vw, 11rem); font-weight: 900; font-style: italic; font-stretch: 70%; text-transform: uppercase; line-height: .9; letter-spacing: -.02em; color: transparent; -webkit-text-stroke: 1.5px rgba(242, 188, 60, .55); white-space: nowrap; user-select: none; }
      .site-footer strong { color: #fff; }
      .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 20px; }
      .foot ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 20px; align-items: flex-start; }
      .foot a { color: #fff; }
    </style>
  </body>
</html>
